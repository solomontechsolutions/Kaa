# ── Supabase ───────────────────────────────────────────────────────────
# Leave these blank to run Kaa entirely off the seed dataset in
# src/lib/data/seed.ts. Every surface works without them; tenant accounts,
# memberships and saved homes then live in an in-process store that resets on
# deploy, which is fine for development and is never production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Surface ────────────────────────────────────────────────────────────
# Absent on the main deployment (kaatz.vercel.app), which serves the website,
# Kaa Operators and the Kaa app.
# Set to `fieldops` on the Field Ops deployment (kaafieldops.vercel.app), which
# then serves only Kaa Field Ops, mounted at its own root.
NEXT_PUBLIC_KAA_SURFACE=

# Where the WhatsApp assistant sends people to unlock and to open a listing.
NEXT_PUBLIC_APP_URL=https://kaatz.vercel.app

# ── Tenant sessions ────────────────────────────────────────────────────
# Signs the tenant session cookie. REQUIRED in production — the app refuses to
# sign with a default there, because anyone who reads the source could
# otherwise mint a session for any account.
#   openssl rand -base64 48
KAA_SESSION_SECRET=

# ── NIDA verification ──────────────────────────────────────────────────
# With these blank the registration flow runs end to end against a clearly
# labelled development stub. It never claims a real identity was confirmed —
# the API response says `source: "development"` and the UI says so too.
NIDA_API_BASE_URL=
NIDA_API_KEY=

# Salts the one-way hash of the NIDA number, which is the only form of it Kaa
# stores. Set this before any real registration: without it a leaked database
# would let someone confirm a guessed NIN by hashing it.
#   openssl rand -base64 32
NIDA_HASH_SALT=

# ── Mobile money ───────────────────────────────────────────────────────
# Selcom and Azampay both aggregate M-Pesa, Tigo Pesa, Airtel Money and
# Halopesa behind one push-to-phone call.
PAYMENTS_PROVIDER=
PAYMENTS_API_BASE_URL=
PAYMENTS_API_KEY=

# Signs the provider's callback. REQUIRED before taking money: the webhook is
# the only thing that activates a membership, so an unsigned one is a way to
# get a year of Kaa for nothing. Kaa refuses unsigned callbacks outright.
PAYMENTS_WEBHOOK_SECRET=

# ── SMS ────────────────────────────────────────────────────────────────
# Phone confirmation codes. Without a provider the code is written to the
# server log so the flow can be exercised; it is never put in a response body.
SMS_PROVIDER=
SMS_API_BASE_URL=
SMS_API_KEY=

# ── WhatsApp Business Platform ─────────────────────────────────────────
# The assistant is another interface into the same Kaa services — same
# properties, same search, same membership. Not a second Kaa.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# The string you type into Meta's webhook setup, echoed back on the handshake.
WHATSAPP_VERIFY_TOKEN=

# Your Meta app secret. Meta signs every delivery with it. REQUIRED: a linked
# WhatsApp number identifies a Kaa account, so an unverified webhook would let
# anyone impersonate any tenant. Kaa refuses unsigned deliveries.
WHATSAPP_APP_SECRET=
