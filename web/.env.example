# ── Supabase ───────────────────────────────────────────────────────────
# Leave these blank to run Kaa entirely off the seed dataset in
# src/lib/data/seed.ts. Every surface works offline without them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Mobile money (not yet wired) ───────────────────────────────────────
# Selcom / Azampay aggregate M-Pesa, Tigo Pesa, Airtel Money and Halopesa.
PAYMENTS_PROVIDER=
PAYMENTS_API_KEY=
PAYMENTS_WEBHOOK_SECRET=

# ── SMS / WhatsApp (not yet wired) ─────────────────────────────────────
# Used for OTP sign-in and the WhatsApp onboarding funnel.
SMS_PROVIDER=
SMS_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ── NIDA verification (not yet wired) ──────────────────────────────────
NIDA_API_BASE_URL=
NIDA_API_KEY=
